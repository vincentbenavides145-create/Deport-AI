# Obligatoria: token de Sportmonks Football API v3
SPORTMONKS_API_TOKEN=pega_aqui_tu_token
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football

# Opcional. Sin esta clave, DEPORT AI usa una explicación determinista.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Ajustes del análisis
DEPORT_AI_RECENT_MATCHES=15
DEPORT_AI_H2H_MATCHES=15
DEPORT_AI_TIMEOUT_SECONDS=20
DEPORT_AI_TIMEZONE=America/Lima
